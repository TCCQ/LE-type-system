// REGRESSION: unknown type name.
//
// This used to pass the LE typechecker and then fail in EasyCrypt with:
//
//   [critical] ... unknown type name: mystery
//
// The typechecker now rejects it with UnknownTypeError.
//
// Repro:
//   python3 __main__.py tests/counterexample_unknown_type.le

module M = {
    var u : mystery :: public;

    proc f() : unit = {
    }
}
