// COUNTEREXAMPLE: procedure call.
//
// This parses, typechecks, and the generated module itself compiles.  The
// full tempfile fails because procedure calls are still a TODO in Proof: the
// generated proof skips the call and EasyCrypt reports:
//
//   [critical] ... left instruction list is not empty
//
// Repro:
//   python3 __main__.py tests/counterexample_proc_call.le
//   easycrypt compile <printed tempfile>

module M = {
    var a : int :: public;

    proc g() : int = {
        return a + 1;
    }

    proc f() : unit = {
        a <@ g();
    }
}
